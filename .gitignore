# env files (do not commit secrets)
# Deliberately broad: this catches backups and variants such as
# `.env.local.backup`, `.env.prod`, `.env.local.bak` — the shapes people
# actually create by hand. Only the committed example is exempt.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor
.vscode/*
!.vscode/extensions.json
.idea/

# drizzle
/drizzle/meta/_journal.json.bak
