{
  "name": "conato",
  "version": "0.1.0",
  "description": "WYSIWYG Markdown editor with Claude-powered writing assistance for long-form work",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/carlosrendonduque/conato.git"
  },
  "homepage": "https://github.com/carlosrendonduque/conato#readme",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "corpus:ingest": "dotenv -e .env.local -- tsx scripts/ingest-corpus.ts",
    "corpus:reset": "dotenv -e .env.local -- tsx scripts/reset-corpus.ts",
    "demo:reset": "npm run corpus:reset -- --dir ./examples/demo-corpus --slug demo --yes",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.74",
    "@tiptap/core": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/diff": "^7.0.2",
    "@types/jszip": "^3.4.1",
    "@types/markdown-it": "^14.1.2",
    "@vercel/functions": "^3.9.8",
    "ai": "^7.0.107",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.3",
    "gray-matter": "^4.0.3",
    "jszip": "^3.10.2",
    "markdown-it": "^15.0.2",
    "next": "^15.1.0",
    "postgres": "^3.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tiptap-markdown": "^0.9.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.0",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "markdown",
    "editor",
    "tiptap",
    "writing",
    "claude",
    "anthropic",
    "rag",
    "nextjs",
    "pgvector"
  ]
}
