# Conato — environment variables
# Copy this file to .env.local and fill in the values. .env.local is gitignored.
#
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- Access gate (v1: a shared secret, not real auth) ---
# The secret you type to unlock the app. 16+ characters.
# The app refuses to start on this placeholder or on low-entropy values.
CONATO_ACCESS_SECRET=""

# Signs the session cookie. Must be different from the one above.
CONATO_COOKIE_SECRET=""

# --- Database (PostgreSQL with the pgvector extension) ---
# Local: the postgres service in docker-compose.yml.
# Serverless (e.g. Neon): always connect to the POOLED endpoint (the host
# containing `-pooler`), or functions will exhaust the connection limit.
# Run migrations against the DIRECT endpoint instead.
DATABASE_URL="postgresql://conato:conato_dev@localhost:5432/conato"

# --- Writing assistance (Anthropic) ---
# Read server-side only; never exposed to the browser. Without it the editor
# still works — you just get no proposals.
ANTHROPIC_API_KEY=""

# --- Embeddings (retrieval) ---
# Voyage 3 Large (1024 dimensions). Without this key, corpus ingestion stores
# files but cannot index them, and similarity retrieval is unavailable.
VOYAGE_API_KEY=""

# --- External read-only sharing (/editor/<token>) ---
# Lets readers open files flagged `share_external` without the access secret.
# Unset means those routes return 404. Note that a token in a URL leaks through
# referrers and browser history — treat it as unlisted, not secret.
CONATO_EDITOR_TOKEN=""
